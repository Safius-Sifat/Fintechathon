# Local foundation only. `pnpm setup:env` creates fresh local infrastructure passwords.
# Empty signing credentials are intentional; no wallets or keys are generated by setup.
APP_ENV=development
CHAIN_ID=84532
POSTGRES_USER=mandate
POSTGRES_DB=mandate
POSTGRES_PASSWORD=
NATS_USER=mandate
NATS_PASSWORD=
API_HOST=127.0.0.1
API_PORT=3000
PROVIDER_HOST=127.0.0.1
PROVIDER_PORT=3001
CONSUL_HTTP_ADDR=http://127.0.0.1:8500
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_INDEPENDENT_RPC_URL=
DEPLOYMENT_MANIFEST_PATH=deployments/base-sepolia.json
JWT_SIGNING_SECRET=
ARTIFACT_STORAGE_KEY_FILE=
EVIDENCE_SIGNING_KEY_FILE=
NORMAL_RELAYER_KEY_FILE=
EMERGENCY_RELAYER_KEY_FILE=
ANCHOR_RELAYER_KEY_FILE=
PROVIDER_A_KEY_FILE=
PROVIDER_B_KEY_FILE=
# x402 (S9.10): facilitator that verifies and settles USDC payments, and this
# provider's public URL for the PAYMENT-REQUIRED resource. Testnet default:
# https://x402.org/facilitator
PROVIDER_X402_FACILITATOR_URL=
PROVIDER_PUBLIC_URL=
# Demo shop (plan 05): signing key whose address the shop is paid at.
SHOP_PRIVATE_KEY=
MPC_INITIATOR_KEY_FILE=
MPC_AUTHORIZER_KEY_FILE=
MODEL_API_KEY=

# Chat agent service (plan 05): OpenAI Agents SDK. The OpenAI key lives only
# here; the API reaches the service with AGENT_SERVICE_TOKEN.
OPENAI_API_KEY=
AGENT_SERVICE_TOKEN=
AGENT_HOST=127.0.0.1
AGENT_PORT=3003
MANDATE_SHOP_URL=
MANDATE_CHAT_MODEL=
# API side of the chat: where the agent service listens and its shared secret.
AGENT_SERVICE_URL=http://127.0.0.1:3003
