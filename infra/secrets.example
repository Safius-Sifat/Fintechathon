# Isolated local qualification only. Set outside Git; never store actual values here.
# setup refuses an existing directory. Preserve it to retain encrypted identities/shares.
MPC_PRIVATE_DIR=/opt/mandate/private/mpc
# Immutable node image ID printed by infra/scripts/build-mpc.sh; no mutable image tag.
MPC_NODE_IMAGE=sha256:REPLACE_WITH_ACTUAL_PINNED_BUILD_ID
# Optional public-only output directory for infra/scripts/qualify-mpc.sh.
MPC_PUBLIC_DIR=/absolute/path/to/repo/evidence/person2/artifacts/mpc-local-run
