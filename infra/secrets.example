# Isolated local qualification only. Set outside Git; never store actual values here.
# setup refuses an existing directory. Preserve it to retain encrypted identities/shares.
MPC_PRIVATE_DIR=/opt/mandate/private/mpc
# Immutable node image ID printed by infra/scripts/build-mpc.sh; no mutable image tag.
MPC_NODE_IMAGE=sha256:REPLACE_WITH_ACTUAL_PINNED_BUILD_ID
# Optional public-only output directory for infra/scripts/qualify-mpc.sh.
MPC_PUBLIC_DIR=/absolute/path/to/repo/evidence/person2/artifacts/mpc-local-run
# Financial runtime file paths (values outside Git; files owner-only). See docs/platform-operations.md.
TRUSTED_MANIFEST_FILE=/opt/mandate/config/manifest.json
EVIDENCE_KEY_FILE=/opt/mandate/private/evidence/ed25519.seed.hex
ARTIFACT_KEY_FILE=/opt/mandate/private/evidence/artifact.aes.hex
WORKER_SIGNING_ENABLED=false
WORKER_NORMAL_KEYSTORE_FILE=/opt/mandate/private/lanes/normal
WORKER_NORMAL_PASSWORD_FILE=/opt/mandate/private/lanes/normal.password
WORKER_NORMAL_ADDRESS=0xREPLACE
ADAPTER_INTERNAL_TOKEN_FILE=/opt/mandate/private/tokens/adapter
AUTHORIZER_INTERNAL_TOKEN_FILE=/opt/mandate/private/tokens/authorizer
POLICY_INTERNAL_TOKEN_FILE=/opt/mandate/private/tokens/policy
