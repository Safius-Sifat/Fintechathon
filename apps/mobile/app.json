{
  "expo": {
    "name": "Mandate",
    "slug": "mandate-wallet",
    "version": "0.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "android": {
      "package": "app.mandate.wallet.dev",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "extra": {
      "chainId": 84532,
      "stage": "bootstrap"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31
          }
        }
      ],
      "./plugins/withFontScaleLayout",
      "@mandate/owner-wallet",
      [
        "expo-camera",
        {
          "cameraPermission": "Mandate uses the camera only to scan QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
