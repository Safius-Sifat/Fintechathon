{
  "expo": {
    "name": "Mandate",
    "slug": "mandate-wallet",
    "version": "0.0.0",
    "orientation": "portrait",
    "platforms": ["android", "ios"],
    "android": {
      "package": "app.mandate.wallet.dev",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8ECEB"
      }
    },
    "extra": {
      "chainId": 84532,
      "stage": "bootstrap",
      "rpcUrl": "https://sepolia.base.org",
      "apiOrigin": "https://mandate-demo-04323111.malaysiawest.cloudapp.azure.com",
      "shopOrigin": "https://mandate-demo-04323111.malaysiawest.cloudapp.azure.com"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31
          }
        }
      ],
      "./plugins/withFontScaleLayout",
      "@mandate/owner-wallet",
      [
        "expo-camera",
        {
          "cameraPermission": "Mandate uses the camera only to scan QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mandate uses Face ID to unlock your wallet and confirm each signature."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Mandate uses Face ID to protect your recovery phrase."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.mandate.wallet.dev",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
